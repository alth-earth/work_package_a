{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/arctic-route/dataset-bundle-v1.schema.json",
  "title": "Work package A immutable dataset bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_digest",
    "corridor_id",
    "as_of_time",
    "requested_start",
    "requested_end",
    "minimum_required_end",
    "requested_data_types",
    "source_snapshot_ids",
    "record_count",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "a.dataset-bundle.v1"},
    "bundle_id": {"type": "string", "pattern": "^a-bundle-[0-9a-f]{24}$"},
    "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corridor_id": {"type": "string", "minLength": 1},
    "as_of_time": {"type": "string", "format": "date-time"},
    "requested_start": {"type": "string", "format": "date-time"},
    "requested_end": {"type": "string", "format": "date-time"},
    "minimum_required_end": {"type": "string", "format": "date-time"},
    "requested_data_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_snapshot_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "record_count": {"type": "integer", "minimum": 0},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_id",
        "data_type",
        "issue_time",
        "valid_time",
        "source",
        "version",
        "quality_flag",
        "checksum",
        "source_snapshot_id"
      ],
      "properties": {
        "data_id": {"type": "string", "minLength": 1},
        "data_type": {"type": "string", "minLength": 1},
        "issue_time": {"type": "string", "format": "date-time"},
        "valid_time": {"type": "string", "format": "date-time"},
        "source": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "quality_flag": {"enum": ["good", "suspect", "degraded"]},
        "checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_snapshot_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+\\-]{0,127}$"
            },
            {"type": "null"}
          ]
        }
      }
    }
  }
}
