{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/arctic-route/incoming-sidecar.schema.json",
  "title": "Work package A incoming sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "file", "payload_sha256", "payload_size_bytes", "publication_id",
    "data_type", "route_id", "issue_time", "valid_time", "source",
    "version", "quality_flag", "metadata"
  ],
  "properties": {
    "file": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_size_bytes": {"type": "integer", "minimum": 0},
    "publication_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,127}$"
    },
    "data_type": {
      "enum": [
        "sea_ice_concentration", "sea_ice_type", "sea_ice_edge", "sea_ice_drift",
        "sea_ice_thickness", "wave", "ocean_current", "water_level", "wind_field",
        "temperature", "visibility", "bathymetry", "long_term_restricted_area"
      ]
    },
    "route_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,127}$"
    },
    "issue_time": {"type": "string", "format": "date-time"},
    "valid_time": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,127}$"
    },
    "quality_flag": {"enum": ["good", "suspect", "degraded"]},
    "metadata": {
      "type": "object",
      "required": ["issue_time_evidence"],
      "dependentRequired": {
        "forecast_reference_time": ["forecast_lead_hours"],
        "forecast_lead_hours": ["forecast_reference_time"]
      },
      "properties": {
        "issue_time_evidence": {"$ref": "#/$defs/issueTimeEvidence"},
        "source_time_index": {"type": "object", "additionalProperties": {"type": "integer"}},
        "forecast_reference_time": {"type": "string", "format": "date-time"},
        "forecast_lead_hours": {"type": "number"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "issueTimeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_time", "method", "authority", "reference",
        "observed_at", "raw_value", "authoritative"
      ],
      "properties": {
        "issue_time": {"type": "string", "format": "date-time"},
        "method": {
          "enum": [
            "copernicus_service_sync", "http_last_modified", "dataset_attribute",
            "explicit_catalog", "conservative_retrieval"
          ]
        },
        "authority": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "raw_value": {"type": "string"},
        "authoritative": {"type": "boolean"}
      }
    }
  }
}
